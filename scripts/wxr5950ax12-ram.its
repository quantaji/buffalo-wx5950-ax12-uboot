/dts-v1/;

/ {
	description = "Buffalo WXR-5950AX12 RAM U-Boot";
	#address-cells = <1>;

	images {
		kernel@1 {
			description = "WXR-5950AX12 RAM U-Boot";
			data = /incbin/("u-boot.bin.gz");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "gzip";
			load = <0x4a000000>;
			entry = <0x4a000000>;

			hash@1 {
				algo = "crc32";
			};

			hash@2 {
				algo = "sha1";
			};
		};

		fdt@hk01 {
			description = "Buffalo WXR-5950AX12 control DTB";
			data = /incbin/("ipq807x-wxr5950ax12.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";

			hash@1 {
				algo = "crc32";
			};

			hash@2 {
				algo = "sha1";
			};
		};
	};

	configurations {
		default = "config@hk01";

		config@hk01 {
			description = "WXR-5950AX12 RAM U-Boot";
			kernel = "kernel@1";
			fdt = "fdt@hk01";
		};
	};
};
